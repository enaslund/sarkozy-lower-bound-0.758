private theorem lower_log_sum :
    (779611234394298033661367881289 / 100000000000000000000000000000 : ℝ) ≤
      Real.log (2431132176156040890913535684 / 1000000000000000000000000 : ℝ) := by
  have h := log_lower_of_integer_quotient_ladder 100000000000000000000000000000000000000000000000000 sumLogLower
    (by decide) (by decide) (by decide)
  have hfirst : sumLogLower 0 = 243113217615604089091353568400000000000000000000000000 := by decide
  have hend : sumLogLower (Fin.last 80) = 100000000000000000000000644879298419497485055118490 := by decide
  rw [hfirst, hend] at h
  have hq : ((243113217615604089091353568400000000000000000000000000 : ℕ) : ℝ) /
      ((100000000000000000000000000000000000000000000000000 : ℕ) : ℝ) =
      (2431132176156040890913535684 / 1000000000000000000000000 : ℝ) := by norm_num
  rw [hq] at h
  exact (show (779611234394298033661367881289 / 100000000000000000000000000000 : ℝ) ≤ _ by norm_num).trans h

private theorem upper_log_root :
    Real.log (3628411 : ℝ) ≤ 15104305369357620761640682336833 / 1000000000000000000000000000000 := by
  have h := log_upper_of_integer_ladder 3628411 100000000000000000000000000000000000000000000000000 rootLogUpper
    (by decide) (by decide) (by decide) (by decide)
  have hend : rootLogUpper (Fin.last 80) = 100000000000000000000001249398856761322166744142461 := by decide
  rw [hend] at h
  exact h.trans (by norm_num)

/-- The explicit lower moment sum suffices for the full record exponent. -/
theorem moment_threshold :
    (3628411^2 : ℝ)^targetExponent ≤
      (3628411 : ℕ) * (2431132176156040890913535684 / 1000000000000000000000000 : ℝ) := by
  apply (Real.log_le_log_iff
    (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 3628411^2) _)
    (by positivity)).mp
  have hcast : ((3628411 : ℕ) : ℝ) = (3628411 : ℝ) := by norm_num
  rw [hcast, Real.log_rpow (by norm_num : (0 : ℝ) < 3628411^2),
    Real.log_mul (by positivity) (by positivity), Real.log_pow]
  have hl := lower_log_sum
  have hu := upper_log_root
  norm_num [targetExponent] at *
  nlinarith

