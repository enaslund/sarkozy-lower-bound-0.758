    (by decide) (by decide) (by decide) (by decide)
  have hend : rootLogUpper (Fin.last 52) = 100000000000000119252119915095677892 := by decide
  rw [hend] at h
  exact h.trans (by norm_num)

/-- The explicit lower moment sum suffices for the full record exponent. -/
theorem moment_threshold :
    (215^6 : ℝ)^targetExponent ≤
      (215^3 : ℕ) * (4088451159413731 / 1000000000000 : ℝ) := by
  apply (Real.log_le_log_iff
    (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 215^6) _)
    (by positivity)).mp
  have hcast : ((215^3 : ℕ) : ℝ) = (215 : ℝ)^3 := by norm_num
  rw [hcast, Real.log_rpow (by norm_num : (0 : ℝ) < 215^6),
    Real.log_mul (by positivity) (by positivity), Real.log_pow, Real.log_pow]
  have hl := lower_log_sum
  have hu := upper_log_root
  norm_num [targetExponent] at *
  nlinarith

