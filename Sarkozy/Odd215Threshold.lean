private theorem lower_log_sum :
    (8315921487685 / 1000000000000 : ℝ) ≤
      Real.log (4088451159413731 / 1000000000000 : ℝ) := by
  have h := log_lower_of_integer_quotient_ladder 100000000000000000000000000000000000 sumLogLower
    (by decide) (by decide) (by decide)
  have hfirst : sumLogLower 0 = 408845115941373100000000000000000000000 := by decide
  have hend : sumLogLower (Fin.last 52) = 100000000000000184650550132080212232 := by decide
  rw [hfirst, hend] at h
  have hq : ((408845115941373100000000000000000000000 : ℕ) : ℝ) /
      ((100000000000000000000000000000000000 : ℕ) : ℝ) =
      (4088451159413731 / 1000000000000 : ℝ) := by norm_num
  rw [hq] at h
  exact (show (8315921487685 / 1000000000000 : ℝ) ≤ _ by norm_num).trans h

private theorem upper_log_root :
    Real.log (215 : ℝ) ≤ 5370638028128 / 1000000000000 := by
