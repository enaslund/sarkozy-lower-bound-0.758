theorem lower_log_growth : (1050904648198512 / 1000000000000000 : ℝ) ≤ Real.log growth := by
  have h := log_lower_of_integer_quotient_ladder 100000000000000000000000000000000000 growthLogLower
    (by decide) (by decide) (by decide)
  have hfirst : growthLogLower 0 = 286023745668600000000000000000000000 := by decide
  have hend : growthLogLower (Fin.last 52) = 100000000000000023334770742311782579 := by decide
  rw [hfirst, hend] at h
  have hg : ((286023745668600000000000000000000000 : ℕ) : ℝ) /
      ((100000000000000000000000000000000000 : ℕ) : ℝ) = growth := by norm_num [growth]
  rw [hg] at h
  exact (show (1050904648198512 / 1000000000000000 : ℝ) ≤ _ by norm_num).trans h

theorem upper_log_two : Real.log (2 : ℝ) ≤ 693147180559946 / 1000000000000000 := by
  have h := log_upper_of_integer_ladder 2 100000000000000000000000000000000000 twoLogUpper
    (by decide) (by decide) (by decide) (by decide)
  have hend : twoLogUpper (Fin.last 52) = 100000000000000015390959186233240947 := by decide
  rw [hend] at h
  exact h.trans (by norm_num)

/-- An explicit margin for the weakened initialization constant `c = 1/4`. -/
theorem depth_margin :
    (27 : ℝ) ≤ Real.log (1/4 : ℝ) +
      ((depth-1 : ℕ) : ℝ)*Real.log growth - (componentPowers 8)*Real.log 2 -
      targetExponent*(depth : ℝ)*Real.log 4 := by
  have hg := lower_log_growth
  have htwo := upper_log_two
  have hfour : Real.log (4 : ℝ) = 2*Real.log 2 := by
    rw [show (4 : ℝ) = (2 : ℝ)^2 by norm_num, Real.log_pow]
    norm_num
  have hquarter : Real.log (1/4 : ℝ) = -2*Real.log 2 := by
    rw [one_div, Real.log_inv, hfour]
    ring
  have hpower : componentPowers 8 = (154942497274 / 1000000000000 : ℝ) := by rfl
  rw [hquarter, hfour, hpower]
  norm_num [depth, targetExponent]
  nlinarith

/-- The fixed-depth condition is fully proved, with no numerical hypothesis. -/
theorem depth_condition : DepthCondition := by
  unfold DepthCondition
  have h := depth_margin
  linarith

