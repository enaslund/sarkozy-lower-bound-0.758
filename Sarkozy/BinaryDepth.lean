theorem lower_log_growth : (8407330007414662543982571401 / 8000000000000000000000000000 : ℝ) ≤ Real.log growth := by
  have h := log_lower_of_integer_quotient_ladder 100000000000000000000000000000000000000000000000000 growthLogLower
    (by decide) (by decide) (by decide)
  have hfirst : growthLogLower 0 = 286027064343666860302843058671229874420200000000000 := by decide
  have hend : growthLogLower (Fin.last 80) = 100000000000000000000000086929754818358890834776755 := by decide
  rw [hfirst, hend] at h
  have hg : ((286027064343666860302843058671229874420200000000000 : ℕ) : ℝ) /
      ((100000000000000000000000000000000000000000000000000 : ℕ) : ℝ) = growth := by norm_num [growth]
  rw [hg] at h
  exact (show (8407330007414662543982571401 / 8000000000000000000000000000 : ℝ) ≤ _ by norm_num).trans h

theorem upper_log_two : Real.log (2 : ℝ) ≤ 69314718055994530941723233951 / 100000000000000000000000000000 := by
  have h := log_upper_of_integer_ladder 2 100000000000000000000000000000000000000000000000000 twoLogUpper
    (by decide) (by decide) (by decide) (by decide)
  have hend : twoLogUpper (Fin.last 80) = 100000000000000000000000057335790940497963733901466 := by decide
  rw [hend] at h
  exact h.trans (by norm_num)

/-- An explicit margin for the weakened initialization constant `c = 1/4`. -/
theorem depth_margin :
    (45 : ℝ) ≤ Real.log (1/4 : ℝ) +
      ((depth-1 : ℕ) : ℝ)*Real.log growth - (componentPowers 8)*Real.log 2 -
      targetExponent*(depth : ℝ)*Real.log 4 := by
  have hg := lower_log_growth
  have htwo := upper_log_two
  have hfour : Real.log (4 : ℝ) = 2*Real.log 2 := by
    rw [show (4 : ℝ) = (2 : ℝ)^2 by norm_num, Real.log_pow]
    norm_num
  have hquarter : Real.log (1/4 : ℝ) = -2*Real.log 2 := by
    rw [one_div, Real.log_inv, hfour]
    ring
  have hpower : componentPowers 8 = (1549247890379023302829202 / 10000000000000000000000000 : ℝ) := by rfl
  rw [hquarter, hfour, hpower]
  norm_num [depth, targetExponent]
  nlinarith

/-- The fixed-depth condition is fully proved, with no numerical hypothesis. -/
theorem depth_condition : DepthCondition := by
  unfold DepthCondition
  have h := depth_margin
  linarith

