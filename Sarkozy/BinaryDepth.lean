/-!
# A kernel-checked depth comparison for the record binary alphabet

Two exact integer square-root ladders, with 80 steps and denominator `10^50`,
bound `log growth` from below and `log 2` from above. Every proposed square comparison is checked by Lean.
The depth remains symbolic: the alphabet of depth `10^20` is not expanded.
-/
namespace Sarkozy

/-- The lower-ladder argument also applies when its initial value is rational. -/
theorem log_lower_of_integer_quotient_ladder {n : ℕ} (D : ℕ)
    (a : Fin (n + 1) → ℕ) (hD : 0 < D) (ha : ∀ i, 0 < a i)
    (hstep : ∀ i : Fin n, (a i.succ)^2 ≤ a i.castSucc * D) :
    (2 : ℝ)^n * (1 - (D : ℝ) / a (Fin.last n)) ≤ Real.log ((a 0 : ℝ) / D) := by
  have hDR : (0 : ℝ) < D := by exact_mod_cast hD
  have hapos (i) : (0 : ℝ) < a i := by exact_mod_cast ha i
  have h := log_lower_of_square_ladder (fun i => (a i : ℝ) / D)
    (fun i => div_pos (hapos i) hDR) (fun i => ?_)
  · simpa using h
  · rw [div_pow]
    apply (div_le_div_iff₀ (by positivity) hDR).mpr
    have hR : (a i.succ : ℝ)^2 ≤ (a i.castSucc : ℝ) * D := by exact_mod_cast hstep i
    nlinarith [mul_le_mul_of_nonneg_right hR (le_of_lt hDR)]

