import Sarkozy.PrimeChains
import Sarkozy.Parameters

/-!
# Kernel-checked numerical moments for the six prime chains

Rational square-root ladders bound logarithms using only integer square
comparisons and `1 - 1/x ≤ log x ≤ x - 1`. All numerical certificates are
checked by ordinary kernel reduction; decimal calculations only propose data.
-/
namespace Sarkozy

/-- Propagate logarithmic lower bounds through a finite square-root ladder. -/
theorem log_lower_of_square_ladder {n : ℕ} (a : Fin (n + 1) → ℝ)
    (ha : ∀ i, 0 < a i) (hstep : ∀ i : Fin n, (a i.succ)^2 ≤ a i.castSucc) :
    (2 : ℝ)^n * (1 - (a (Fin.last n))⁻¹) ≤ Real.log (a 0) := by
  have hchain : ∀ k : ℕ, ∀ hk : k ≤ n,
      (2 : ℝ)^k * Real.log (a ⟨k, by omega⟩) ≤ Real.log (a 0) := by
    intro k
    induction k with
    | zero => intro hk; simp
    | succ k ih =>
      intro hk
      have hlog : 2 * Real.log (a ⟨k + 1, by omega⟩) ≤
          Real.log (a ⟨k, by omega⟩) := by
        have hh := (Real.log_le_log_iff (sq_pos_of_pos (ha (⟨k + 1, by omega⟩ : Fin (n+1)))) (ha (⟨k, by omega⟩ : Fin (n+1)))).mpr (hstep ⟨k, by omega⟩)
        simpa only [Real.log_pow, Nat.cast_ofNat] using hh
      calc
        (2 : ℝ)^(k+1) * Real.log (a ⟨k+1, by omega⟩) =
            (2 : ℝ)^k * (2 * Real.log (a ⟨k+1, by omega⟩)) := by ring
        _ ≤ (2 : ℝ)^k * Real.log (a ⟨k, by omega⟩) :=
          mul_le_mul_of_nonneg_left hlog (by positivity)
        _ ≤ Real.log (a 0) := ih (by omega)
  exact (mul_le_mul_of_nonneg_left (Real.one_sub_inv_le_log_of_pos (ha _))
    (by positivity : (0 : ℝ) ≤ 2^n)).trans (hchain n le_rfl)

/-- Propagate logarithmic upper bounds through a finite square-root ladder. -/
theorem log_upper_of_square_ladder {n : ℕ} (a : Fin (n + 1) → ℝ)
    (ha : ∀ i, 0 < a i) (hstep : ∀ i : Fin n, a i.castSucc ≤ (a i.succ)^2) :
    Real.log (a 0) ≤ (2 : ℝ)^n * (a (Fin.last n) - 1) := by
  have hchain : ∀ k : ℕ, ∀ hk : k ≤ n,
      Real.log (a 0) ≤ (2 : ℝ)^k * Real.log (a ⟨k, by omega⟩) := by
    intro k
    induction k with
    | zero => intro hk; simp
    | succ k ih =>
      intro hk
      have hlog : Real.log (a ⟨k, by omega⟩) ≤
          2 * Real.log (a ⟨k + 1, by omega⟩) := by
        have hh := (Real.log_le_log_iff (ha (⟨k, by omega⟩ : Fin (n+1))) (sq_pos_of_pos (ha (⟨k + 1, by omega⟩ : Fin (n+1))))).mpr (hstep ⟨k, by omega⟩)
        simpa only [Real.log_pow, Nat.cast_ofNat] using hh
      calc
        Real.log (a 0) ≤ (2 : ℝ)^k * Real.log (a ⟨k, by omega⟩) := ih (by omega)
        _ ≤ (2 : ℝ)^k * (2 * Real.log (a ⟨k+1, by omega⟩)) :=
          mul_le_mul_of_nonneg_left hlog (by positivity)
        _ = (2 : ℝ)^(k+1) * Real.log (a ⟨k+1, by omega⟩) := by ring
  exact (hchain n le_rfl).trans (mul_le_mul_of_nonneg_left
    (Real.log_le_sub_one_of_pos (ha _)) (by positivity : (0 : ℝ) ≤ 2^n))

/-- Integer certificate for a logarithmic lower bound. -/
theorem log_lower_of_integer_ladder {n : ℕ} (x D : ℕ) (a : Fin (n + 1) → ℕ)
    (hD : 0 < D) (ha : ∀ i, 0 < a i) (hfirst : a 0 = x * D)
    (hstep : ∀ i : Fin n, (a i.succ)^2 ≤ a i.castSucc * D) :
    (2 : ℝ)^n * (1 - (D : ℝ) / a (Fin.last n)) ≤ Real.log x := by
  have hDR : (0 : ℝ) < D := by exact_mod_cast hD
  have hapos (i) : (0 : ℝ) < a i := by exact_mod_cast ha i
  have h := log_lower_of_square_ladder (fun i => (a i : ℝ) / D)
    (fun i => div_pos (hapos i) hDR) (fun i => ?_)
  · simpa [hfirst, Nat.cast_mul, ne_of_gt hDR] using h
  · rw [div_pow]
    apply (div_le_div_iff₀ (by positivity) hDR).mpr
    have hR : (a i.succ : ℝ)^2 ≤ (a i.castSucc : ℝ) * D := by exact_mod_cast hstep i
    nlinarith [mul_le_mul_of_nonneg_right hR (le_of_lt hDR)]

/-- Integer certificate for a logarithmic upper bound. -/
theorem log_upper_of_integer_ladder {n : ℕ} (x D : ℕ) (a : Fin (n + 1) → ℕ)
    (hD : 0 < D) (ha : ∀ i, 0 < a i) (hfirst : a 0 = x * D)
    (hstep : ∀ i : Fin n, a i.castSucc * D ≤ (a i.succ)^2) :
    Real.log x ≤ (2 : ℝ)^n * ((a (Fin.last n) : ℝ) / D - 1) := by
  have hDR : (0 : ℝ) < D := by exact_mod_cast hD
  have hapos (i) : (0 : ℝ) < a i := by exact_mod_cast ha i
  have h := log_upper_of_square_ladder (fun i => (a i : ℝ) / D)
    (fun i => div_pos (hapos i) hDR) (fun i => ?_)
  · simpa [hfirst, Nat.cast_mul, ne_of_gt hDR] using h
  · rw [div_pow]
    apply (div_le_div_iff₀ hDR (by positivity)).mpr
    have hR : (a i.castSucc : ℝ) * D ≤ (a i.succ : ℝ)^2 := by exact_mod_cast hstep i
    nlinarith [mul_le_mul_of_nonneg_right hR (le_of_lt hDR)]

