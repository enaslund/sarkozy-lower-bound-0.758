-- END GENERATED INTEGER LOG CERTIFICATES

/-- The logarithmic form of the equal-width prime-chain moment bound. -/
theorem primeChain_moment_of_log (p t α f : ℝ) (hp : 0 < p) (ht : 0 < t)
    (hlog : (2 * α - 1) * Real.log p ≤ (1 - f) * Real.log t) :
    (p^2)^α ≤ t * p * (1 / t)^f := by
  apply (Real.log_le_log_iff (Real.rpow_pos_of_pos (sq_pos_of_pos hp) α)
    (mul_pos (mul_pos ht hp) (Real.rpow_pos_of_pos (one_div_pos.mpr ht) f))).mp
  rw [Real.log_rpow (sq_pos_of_pos hp), Real.log_pow,
    Real.log_mul (ne_of_gt (mul_pos ht hp))
      (ne_of_gt (Real.rpow_pos_of_pos (one_div_pos.mpr ht) f)),
    Real.log_mul (ne_of_gt ht) (ne_of_gt hp),
    Real.log_rpow (one_div_pos.mpr ht), one_div, Real.log_inv]
  norm_num
  nlinarith [hlog]

/-- Every rounded chain power has a positive, kernel-certified margin. -/
theorem concretePrime_log_moment (i : Fin 6) :
    (2 * targetExponent - 1) * Real.log (primeChainPrimes i) ≤
      (1 - componentPowers (Fin.castLE (by decide : 6 ≤ 9) i)) *
        Real.log (primeChainLengths i) := by
  fin_cases i
  · have hp := chain_log_upper_3
    have ht := chain_log_lower_2
    norm_num [targetExponent, componentPowers, primeChainPrimes, primeChainLengths, Fin.castLE]
    nlinarith
  · have hp := chain_log_upper_7
    have ht := chain_log_lower_3
    norm_num [targetExponent, componentPowers, primeChainPrimes, primeChainLengths, Fin.castLE]
    nlinarith
  · have hp := chain_log_upper_11
    have ht := chain_log_lower_4
    norm_num [targetExponent, componentPowers, primeChainPrimes, primeChainLengths, Fin.castLE]
    nlinarith
  · have hp := chain_log_upper_31
    have ht := chain_log_lower_7
    norm_num [targetExponent, componentPowers, primeChainPrimes, primeChainLengths, Fin.castLE]
    nlinarith
  · have hp := chain_log_upper_59
    have ht := chain_log_lower_9
    norm_num [targetExponent, componentPowers, primeChainPrimes, primeChainLengths, Fin.castLE]
    nlinarith
  · have hp := chain_log_upper_103
    have ht := chain_log_lower_11
    norm_num [targetExponent, componentPowers, primeChainPrimes, primeChainLengths, Fin.castLE]
    nlinarith

/-- The six actual alphabet moments require no external numerical hypotheses. -/
theorem concretePrime_certified_moment (i : Fin 6) :
    (componentBases (Fin.castLE (by decide : 6 ≤ 9) i) : ℝ)^targetExponent ≤
      ∑ x ∈ concretePrimeDigits i,
        (concretePrimeWidth i x)^(componentPowers (Fin.castLE (by decide : 6 ≤ 9) i)) := by
  rw [concretePrime_moment]
  have hbase : (componentBases (Fin.castLE (by decide : 6 ≤ 9) i) : ℝ) =
      (primeChainPrimes i : ℝ)^2 := by
    fin_cases i <;> norm_num [componentBases, componentRoots, componentDepths, primeChainPrimes, Fin.castLE]
  rw [hbase]
  have hp : (0 : ℝ) < primeChainPrimes i := by exact_mod_cast (primeChainPrimes_prime i).pos
  have ht : (0 : ℝ) < primeChainLengths i := by exact_mod_cast primeChainLengths_pos i
  simpa only [Nat.cast_mul] using primeChain_moment_of_log
    (primeChainPrimes i) (primeChainLengths i) targetExponent
    (componentPowers (Fin.castLE (by decide : 6 ≤ 9) i)) hp ht (concretePrime_log_moment i)

