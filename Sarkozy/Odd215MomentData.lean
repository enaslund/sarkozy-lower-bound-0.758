/-- The finite check includes the link from certificate endpoints to the actual width. -/
def momentEntryCheck (e : MomentEntry) : Bool :=
  decide (e.certificate.a0 = e.width * 10000000000000000 ∧
    e.certificate.b0 = e.lower * 1000000) &&
    decide (PowerChecker.EndpointValid 1000000000000000000000000000000 264983230432418544045862 10000000000000000000000000 4095 e.certificate)

/-- Analytic soundness of one checked row of the histogram. -/
theorem moment_entry_lower (e : MomentEntry) (he : momentEntryCheck e = true) :
    (e.lower : ℝ) / 1000000000000000000000000 ≤
      ((e.width : ℝ) / 100000000000000) ^ (264983230432418544045862 / 10000000000000000000000000 : ℝ) := by
  have hh := Bool.and_eq_true_iff.mp he
  have heq : e.certificate.a0 = e.width * 10000000000000000 ∧
      e.certificate.b0 = e.lower * 1000000 := of_decide_eq_true hh.1
  have hc : PowerChecker.EndpointValid 1000000000000000000000000000000 264983230432418544045862 10000000000000000000000000 4095 e.certificate :=
    of_decide_eq_true hh.2
  have h := PowerChecker.endpoint_valid_sound hc
  have ha : (e.certificate.a0 : ℝ) / 1000000000000000000000000000000 =
      (e.width : ℝ) / 100000000000000 := by
    rw [heq.1]
    push_cast
    ring
  have hb : (e.certificate.b0 : ℝ) / 1000000000000000000000000000000 =
      (e.lower : ℝ) / 1000000000000000000000000 := by
    rw [heq.2]
    push_cast
    ring
  norm_num only [Nat.cast_ofNat, Rat.cast_div, Rat.cast_natCast] at h ⊢
  simpa only [ha, hb] using h

/-- Add checked lower endpoints with their natural-number multiplicities. -/
theorem moment_entries_lower (es : List MomentEntry)
    (he : es.all momentEntryCheck = true) :
    (((es.map (fun e => e.multiplicity * e.lower)).sum : ℕ) : ℝ) / 1000000000000000000000000 ≤
      (es.map (fun e => (e.multiplicity : ℝ) *
        ((e.width : ℝ) / 100000000000000) ^
          (264983230432418544045862 / 10000000000000000000000000 : ℝ))).sum := by
  induction es with
  | nil => simp
  | cons e es ih =>
    have hh := Bool.and_eq_true_iff.mp he
    have hp := mul_le_mul_of_nonneg_left (moment_entry_lower e hh.1)
      (Nat.cast_nonneg e.multiplicity : (0 : ℝ) ≤ e.multiplicity)
    have ht := ih hh.2
    simp only [List.map_cons, List.sum_cons, Nat.cast_add, Nat.cast_mul, add_div]
    nlinarith

