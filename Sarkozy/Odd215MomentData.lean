theorem moment_histogram_eq_entries :
    momentHistogram = momentEntries.map (fun e => (e.width, e.multiplicity)) := by
  decide +kernel

theorem moment_lower_numerator_sum :
    (momentEntries.map (fun e => e.multiplicity * e.lower)).sum = 4089554252844355796121018868 := by
  decide +kernel

/-- The checked lower endpoints give the stated real-power histogram moment. -/
theorem moment_histogram_lower_bound :
    (4089554252844355796121018868 / 1000000000000000000000000 : ℝ) ≤
      (momentHistogram.map (fun wc => (wc.2 : ℝ) *
        ((wc.1 : ℝ) / 100000000000000) ^
          (264983230432418544045862 / 10000000000000000000000000 : ℝ))).sum := by
  have h := moment_entries_lower momentEntries moment_entries_checked
  rw [moment_lower_numerator_sum] at h
  rw [moment_histogram_eq_entries, List.map_map]
  simpa only [Function.comp_def, Nat.cast_ofNat] using h

