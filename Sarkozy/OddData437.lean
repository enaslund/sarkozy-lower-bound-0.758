def row (k : Fin 3645) : OddData.Row :=
  rows.get (Fin.cast rows_size.symm k)

def point (k : Fin 3645) (i : Fin 2) : ℕ := ![(row k).1.1, (row k).1.2] i

def start (k : Fin 3645) : ℕ := (row k).2.1

def width (k : Fin 3645) : ℕ := (row k).2.2

theorem denominator_pos : 0 < denominator := by decide +kernel

theorem row_bounds (k : Fin 3645) :
    (row k).1.1 < 6859 ∧ (row k).1.2 < 529 ∧
    0 < width k ∧ width k < denominator ∧ start k + width k ≤ denominator :=
  OddData.bounds_of_list_all 6859 529 denominator rows rows_valid (Fin.cast rows_size.symm k)

theorem point_bounds (k : Fin 3645) (i : Fin 2) :
    point k i < (recordOddPrimes 1 i)^(recordOddDepths 1 i) := by
  have h := row_bounds k
  fin_cases i
  · change (row k).1.1 < 6859
    exact h.1
  · change (row k).1.2 < 529
    exact h.2.1

theorem point_injective : Function.Injective point := by
  intro a b hab
  have hpair : (row a).1 = (row b).1 := by
    apply Prod.ext
    · exact congrFun hab 0
    · exact congrFun hab 1
  have hind := OddData.pair_injective_of_sorted 6859 rows rows_sorted hpair
  exact Fin.cast_injective _ hind

theorem width_bounds (k : Fin 3645) : 0 < width k ∧ width k < denominator :=
  ⟨(row_bounds k).2.2.1, (row_bounds k).2.2.2.1⟩

theorem endpoint_bound (k : Fin 3645) : start k + width k ≤ denominator :=
  (row_bounds k).2.2.2.2

end

end Sarkozy.Odd437
